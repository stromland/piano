{
  "name": "@stromland/piano-lib",
  "version": "0.4.3",
  "description": "Scales, chords and keyboard layout for a piano, as plain functions.",
  "author": "Espen Strømland",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf lib coverage"
  },
  "devDependencies": {
    "rimraf": "6.1.4"
  }
}
